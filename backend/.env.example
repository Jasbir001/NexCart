# Backend environment variables (example)
# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=http://localhost:3000,https://your-frontend-domain

# MongoDB Atlas URI
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexcart?retryWrites=true&w=majority

# JWT secret
# JWT_SECRET=change_this_in_production

# SMTP (email) settings - DO NOT COMMIT REAL SECRETS
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password_here
# SMTP_FROM="NexCart Orders" <noreply@nexcart.com>
